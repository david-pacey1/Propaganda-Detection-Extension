{
  "manifest_version": 3,
  "name": "Proper Gander — in-place context for social media",
  "version": "1.8.3",
  "description": "Adds discreet, dismissible analysis overlays alongside posts on X, Bluesky, Facebook, Instagram, LinkedIn and Reddit. An AI agent detects persuasion signals, manipulation techniques and unsourced claims, and verifies claims against the web.",
  "permissions": ["storage"],
  "host_permissions": [
    "<all_urls>",
    "https://twitter.com/*",
    "https://x.com/*",
    "https://bsky.app/*",
    "https://www.facebook.com/*",
    "https://www.instagram.com/*",
    "https://www.linkedin.com/*",
    "https://www.reddit.com/*"
  ],
  "action": {
    "default_title": "Proper Gander",
    "default_popup": "popup.html",
    "default_icon": { "16": "icon.png", "48": "icon.png", "128": "icon.png" }
  },
  "icons": { "16": "icon.png", "48": "icon.png", "128": "icon.png" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*",
        "https://bsky.app/*",
        "https://www.facebook.com/*",
        "https://www.instagram.com/*",
        "https://www.linkedin.com/*",
        "https://www.reddit.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
